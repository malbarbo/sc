     } else {
       NamespaceDecl *ND = cast<NamespaceDecl>(Parent);
       PrevNS = ND->getAnonymousNamespace();
@@ -12124,7 +12126,7 @@ Decl *Sema::ActOnStartNamespaceDef(Scope *NamespcScope,
