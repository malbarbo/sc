# libc++, libc++abi and libunwind for wasm32-wasip1, built with the pin's clang
set(CMAKE_SYSTEM_NAME WASI)
set(CMAKE_SYSTEM_VERSION 1)
set(CMAKE_SYSTEM_PROCESSOR wasm32)
list(APPEND CMAKE_MODULE_PATH @WASI_SDK@/share/cmake)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_C_COMPILER @NATIVE@/bin/clang)
set(CMAKE_CXX_COMPILER @NATIVE@/bin/clang++)
set(CMAKE_ASM_COMPILER @NATIVE@/bin/clang)
set(CMAKE_C_COMPILER_TARGET wasm32-wasip1)
set(CMAKE_CXX_COMPILER_TARGET wasm32-wasip1)
set(CMAKE_ASM_COMPILER_TARGET wasm32-wasip1)
set(CMAKE_AR @WASI_SDK@/bin/llvm-ar)
set(CMAKE_RANLIB @WASI_SDK@/bin/llvm-ranlib)
set(CMAKE_SYSROOT @WASI_SDK@/share/wasi-sysroot)
set(CMAKE_C_COMPILER_WORKS ON)
set(CMAKE_CXX_COMPILER_WORKS ON)
